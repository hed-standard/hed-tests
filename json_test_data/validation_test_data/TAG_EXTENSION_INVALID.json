        "name": "tag-extension-invalid-no-letter",
        "description": "A tag extension term contains no letter (Item/Blech/3, Item/1-2, Item/_). An extension term must contain at least one letter: A-Z or a-z, or any Unicode letter in schema versions whose nameClass allows non-ASCII characters (8.3.0 and later), so a non-ASCII term with no letter (a degree sign, an Arabic-Indic digit) also fails.",
        "warning": false,
        "schema": "8.4.0",
        "error_category": "semantic",
        "common_causes": [
            "Writing a number after a tag that does not take a value, as if it did (Item/3)",
            "Using a numeric code as a new term instead of a word",
            "Expecting Item/1-2 to describe a range or a pair"
        ],
        "explanation": "An extension adds a new term under a tag that allows extensions, and a term must contain at least one letter: A-Z, a-z, or any Unicode letter in schema versions that allow non-ASCII terms. A term such as 3 or 1-2 looks like a value, but the tag takes no value. A term may still begin with a digit when it contains a letter (1red, 3D-printout). To record a number, use a tag that takes a value.",
        "correction_strategy": "Give the extension a term with a letter, or record the number with a tag that takes a value",
        "correction_examples": [
            {
                "wrong": "Item/Blech/3",
                "correct": "Item/Blech, Item-count/3",
                "explanation": "The count goes on Item-count, which takes a numeric value"
            },
            {
                "wrong": "Item/1-2",
                "correct": "Item/Pair-item",
                "explanation": "The new term contains letters"
            }
        ],
