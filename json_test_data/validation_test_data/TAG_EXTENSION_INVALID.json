        "name": "tag-extension-invalid-reserved-tag-placeholder",
        "description": "A # follows a reserved tag that takes no value. It is an error in every context: a HED string ((Event-context/#, (Red)), since string tests use no temporal tag), an events file, a sidecar value column, and a combo ((Onset/#, Def/MyColor)). A validator may report it as TAG_EXTENSION_INVALID (the # extends a reserved tag) or as PLACEHOLDER_INVALID (the # has no placeholder child to stand for, or is not allowed there at all), depending on which check finds it first.",
        "warning": false,
        "schema": "8.4.0",
        "error_category": "semantic",
        "common_causes": [
            "Treating Onset as a tag that takes a value and putting the value column's # on it",
            "Copying a sidecar value-column annotation with its # into a HED column"
        ],
        "explanation": "Onset and the other reserved tags take no value, so a # placed on them stands for nothing. Put the value column's placeholder on a tag that takes a value, inside the reserved tag's group.",
        "correction_strategy": "Move the # to a tag that takes a value inside the group",
        "correction_examples": [
            {
                "wrong": "trial: (Onset/#, Def/MyColor)",
                "correct": "trial: (Onset, Def/MyColor, (Label/#))",
                "explanation": "The value column's placeholder goes on a tag that takes a value"
            },
            {
                "wrong": "(Event-context/#, (Red))",
                "correct": "(Event-context, (Red))",
                "explanation": "Event-context takes no value, and no # belongs in a HED string or events file"
            }
        ],
        "specification_reference": "3.2.5. Tag extensions; 3.2.8. Reserved tags; Appendix B TAG_EXTENSION_INVALID c, PLACEHOLDER_INVALID a and d",
        "related_errors": [
