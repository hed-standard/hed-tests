        "name": "units-invalid-symbol-plural",
        "description": "A unit symbol cannot be pluralized, and a unit name accepts only its standard English plural.",
        "warning": false,
        "schema": "8.4.0",
        "error_category": "validation",
        "common_causes": [
            "Adding s to a unit symbol (mss, Hzs)",
