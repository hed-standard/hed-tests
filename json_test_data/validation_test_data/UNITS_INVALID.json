        "name": "units-invalid-case",
        "description": "Units are case-sensitive: a unit name, unit symbol, or SI modifier written in a case other than the one listed in the schema is invalid.",
        "warning": false,
        "schema": "8.4.0",
        "error_category": "validation",
        "common_causes": [
            "Capitalizing a unit name at the start of a value (Seconds, Feet)",
            "Capitalizing an SI modifier (Milliseconds instead of milliseconds)",
            "Writing a unit symbol in the wrong case (MS for ms, hz for Hz)",
            "Assuming units follow the case-insensitive rule that applies to tags"
        ],
        "explanation": "HED tags are case-insensitive, but units are not. Every unit string - the unit name, the unit symbol, and any SI modifier - must match the schema exactly. This is what keeps m (milli) distinct from M (mega) and mV distinct from MV.",
        "correction_strategy": "Write the unit exactly as it appears in the schema, including any SI modifier",
        "correction_examples": [
            {
                "wrong": "Time-value/5 Milliseconds",
                "correct": "Time-value/5 milliseconds",
                "explanation": "The modifier milli is lowercase"
