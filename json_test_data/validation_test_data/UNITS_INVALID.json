                "wrong": "Length/3 Feet",
                "correct": "Length/3 feet",
                "explanation": "Unit names are written as listed in the schema"
            },
            {
                "wrong": "Time-value/5 MS",
                "correct": "Time-value/5 ms",
                "explanation": "The symbol for millisecond is ms; MS is not a unit"
            },
            {
                "wrong": "Frequency/3 hz",
                "correct": "Frequency/3 Hz",
                "explanation": "The hertz symbol is Hz"
            }
        ],
        "correction_patterns": [
            "Lowercase unit names and modifiers",
            "Match symbol case exactly (Hz, ms, uV, km)",
            "Do not capitalize a unit because it starts the value"
        ],
        "fix_instructions": [
            "1. Find the unit in the schema unit class listing",
            "2. Copy its spelling and case exactly",
            "3. If an SI modifier is used, write it as listed (milli, k, u), never capitalized"
        ],
        "validation_hints": [
            "Compare the unit string to the schema with case preserved",
            "Check the modifier prefix separately from the base unit",
            "Symbols and names are both case-sensitive"
